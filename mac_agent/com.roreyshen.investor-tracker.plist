<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roreyshen.investor-tracker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/mac_agent/agent.py</string>
  </array>

  <!-- Every 5 minutes. If the Mac was asleep, launchd runs it once on wake
       rather than replaying every missed interval. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO__/mac_agent/agent.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/mac_agent/agent.log</string>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- git needs a usable PATH; launchd jobs get a minimal one by default. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
